{
  "hosting": {
    "site": "pt7-academy",
    "public": "dist",
    "ignore": [
      "CNAME",
      "**/.DS_Store",
      "**/.gitkeep",
      "screen/screen_display.mp4"
    ],
    "rewrites": [
      {
        "source": "/api/**",
        "run": {
          "serviceId": "pt7-api",
          "region": "europe-west4"
        }
      }
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          {
            "key": "X-Content-Type-Options",
            "value": "nosniff"
          }
        ]
      },
      {
        "source": "/assets/*.@(js|css)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          }
        ]
      },
      {
        "source": "/.well-known/api-catalog",
        "headers": [
          {
            "key": "Content-Type",
            "value": "application/linkset+json"
          }
        ]
      },
      {
        "source": "/academy/trainee/**",
        "headers": [
          {
            "key": "Content-Security-Policy",
            "value": "frame-ancestors 'none'"
          },
          {
            "key": "X-Frame-Options",
            "value": "DENY"
          },
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      }
    ]
  }
}
