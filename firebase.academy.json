{
  "hosting": {
    "site": "pt7-academy-trainee",
    "public": "dist-academy",
    "ignore": [
      "**/.DS_Store",
      "**/.gitkeep"
    ],
    "rewrites": [
      {
        "source": "/api/**",
        "run": {
          "serviceId": "pt7-api",
          "region": "europe-west4"
        }
      }
    ],
    "headers": [
      {
        "source": "!/api/**",
        "headers": [
          {
            "key": "Content-Security-Policy",
            "value": "frame-ancestors 'none'"
          }
        ]
      },
      {
        "source": "**",
        "headers": [
          {
            "key": "X-Frame-Options",
            "value": "DENY"
          },
          {
            "key": "X-Content-Type-Options",
            "value": "nosniff"
          }
        ]
      },
      {
        "source": "/",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      },
      {
        "source": "/index.html",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      },
      {
        "source": "/assets/*.@(js|css)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          }
        ]
      }
    ]
  }
}
