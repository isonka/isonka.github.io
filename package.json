{
  "name": "ptstudio7-react",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/copy-spa-404.js && npm run routes:manifest && node scripts/generate-static-routes.js && node scripts/prerender-static-html.js",
    "build:only": "tsc -b && vite build && node scripts/copy-spa-404.js",
    "routes:manifest": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/generate-routes-manifest.js",
    "lint": "eslint .",
    "fonts": "node scripts/fetch-fonts.js",
    "images:webp": "node scripts/convert-to-webp.js",
    "images:share": "node scripts/make-share-image.js",
    "seo:collect": "node scripts/seo-agent/collect.js",
    "seo:snapshot": "node scripts/seo-agent/snapshot.js",
    "seo:evaluate": "node scripts/seo-agent/evaluate.js",
    "seo:weekly": "npm run seo:collect && npm run seo:snapshot && npm run seo:evaluate",
    "seo:test": "node --test scripts/seo-agent/test/evaluate.test.js",
    "preview": "vite preview",
    "predeploy": "npm run build",
    "deploy": "gh-pages -d dist"
  },
  "dependencies": {
    "i18next": "^25.4.2",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-i18next": "^15.7.3",
    "react-router-dom": "^7.9.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.5",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "gh-pages": "^6.3.0",
    "globals": "^17.13.0",
    "puppeteer": "^25.16.0",
    "sharp": "^0.35.5",
    "typescript": "~7.0.2",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5"
  }
}
